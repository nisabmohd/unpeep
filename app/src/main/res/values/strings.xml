    <!-- How Keyhole works, What Keyhole can't find -->
    <string name="how_wifi">Asks the devices on the Wi-Fi you\'re on what they are, and flags the ones that answer like cameras.</string>
    <string name="how_hotspots">Lists the Wi-Fi names around you and flags the ones cheap cameras use for setup.</string>
    <string name="how_bluetooth">Listens for trackers like AirTags and Tiles, and for Bluetooth names that read like cameras.</string>
    <string name="how_lens">Uses the torch and the rear camera to ring small, bright dots that may be a lens.</string>
    <string name="how_infrared">Uses the front camera in the dark to show infrared lights, which many night cameras have.</string>
    <string name="how_magnet">Learns the room\'s normal magnetic field and shows when it jumps near electronics.</string>
    <string name="how_checklist">Walks you through the places worth a look by hand, with photos and notes.</string>
    <string name="how_note">Every check runs only when you start it, and nothing leaves your phone.</string>
    <string name="limits_intro">No check can promise a room is safe. This is what Keyhole can\'t see, and how to look by hand.</string>
    <string name="limit_memory_card">Cameras that record to a memory card and send nothing: only the lens finder, infrared, magnet and checklist help.</string>
    <string name="limit_other_network">Cameras on another network, on mobile data, or on a Wi-Fi the phone can\'t see.</string>
    <string name="limit_isolation">Hotel and guest Wi-Fi that keeps devices apart: other devices don\'t answer.</string>
    <string name="limit_mac">Android hides other devices\' hardware addresses, so a maker can\'t be looked up from them.</string>
    <string name="limit_trackers">Trackers that don\'t advertise, or do it in a way Keyhole doesn\'t know yet.</string>
    <string name="limit_infrared">Phones whose camera blocks infrared can\'t see infrared lights; the TV-remote test tells you.</string>
    <string name="limit_hotspot_scans">Android allows 4 Wi-Fi scans every 2 minutes, so hotspots update slowly.</string>
    <string name="limit_magnet">The magnet reacts to any electronics, magnets and wiring, not just cameras.</string>
    <string name="limit_lens">The lens finder rings anything that shines like a lens: glass, screws and jewellery too.</string>
    <string name="limits_by_hand">The checklist walks you through looking by hand, place by place.</string>

    <!-- 16 Privacy -->
    <string name="privacy_header_line">No account, no ads, no tracking. Scans only talk to devices on the Wi-Fi you\'re on.</string>
    <string name="why_keyhole_asks">Why Keyhole asks</string>
    <string name="perm_row_wifi_line">To list devices on the Wi-Fi you\'re on. No permission needed.</string>
