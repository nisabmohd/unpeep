<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press Unpeep's icon. Each starts MainActivity with an action (MainActivity.ACTION_*); icons from
     tools/solar_icon.py (shortcuts mode). Static, so nothing runs in the background to keep them up to date. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="sweep" android:enabled="true" android:icon="@drawable/shortcut_sweep"
        android:shortcutShortLabel="@string/check_this_room" android:shortcutLongLabel="@string/check_this_room">
        <intent android:action="app.unpeep.privacy.action.SWEEP"
            android:targetPackage="app.unpeep.privacy" android:targetClass="app.unpeep.privacy.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="lens" android:enabled="true" android:icon="@drawable/shortcut_lens"
        android:shortcutShortLabel="@string/lens_finder" android:shortcutLongLabel="@string/lens_finder">
        <intent android:action="app.unpeep.privacy.action.LENS"
            android:targetPackage="app.unpeep.privacy" android:targetClass="app.unpeep.privacy.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="magnet" android:enabled="true" android:icon="@drawable/shortcut_magnet"
        android:shortcutShortLabel="@string/check_magnet" android:shortcutLongLabel="@string/check_magnet">
        <intent android:action="app.unpeep.privacy.action.MAGNET"
            android:targetPackage="app.unpeep.privacy" android:targetClass="app.unpeep.privacy.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="reports" android:enabled="true" android:icon="@drawable/shortcut_reports"
        android:shortcutShortLabel="@string/tab_reports" android:shortcutLongLabel="@string/tab_reports">
        <intent android:action="app.unpeep.privacy.action.REPORTS"
            android:targetPackage="app.unpeep.privacy" android:targetClass="app.unpeep.privacy.MainActivity" />
    </shortcut>
</shortcuts>
